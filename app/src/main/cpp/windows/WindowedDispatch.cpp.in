    // The absolute invocation index is retained for noise and geometry. Each
    // storage binding independently names only the interval this launch reads.
    bool dispatch(const char* kernel, const std::vector<Arg>& args, size_t threads,
                  std::string& error) override {
        if (theia::export_execution::one_shot && kernel && std::strcmp(kernel, "spk_reduce_max") == 0 &&
            !args.empty() && args[0].buffer && args[0].buffer->used > window_budget())
            return dispatch_reduce_windows(args, threads, error);
        if (!theia::export_execution::one_shot || !kernel || std::strcmp(kernel, "spk_reduce_max") == 0 ||
            std::strcmp(kernel, "spk_split_probe") == 0 || std::strcmp(kernel, "spk_math_probe") == 0)
            return dispatch_legacy(kernel, args, threads, error);
        if (!threads)
            return true;
        if (threads > std::numeric_limits<uint32_t>::max()) {
            error = "Export invocation count exceeds the exact 32-bit shader contract";
            return false;
        }
        if (std::strcmp(kernel, "spk_iir_df_acc") == 0) {
            const auto meta = window_words(args, 5, 4, error);
            if (meta.empty())
                return false;
            // Complete columns are packed into small scratch planes. Both
            // recurrence sweeps still visit every sample in the same order.
            if (meta[3] == 0 && uint64_t(meta[0]) * meta[1] * 12 > window_budget())
                return dispatch_iir_columns(args, meta, error);
        }
        return dispatch_windowed(kernel, args, threads, error);
    }

    uint64_t forced_storage_range() const {
        char setting[PROP_VALUE_MAX]{};
        if (__system_property_get("debug.theia.storage_range_bytes", setting) <= 0)
            return 0;
        const uint64_t value = std::strtoull(setting, nullptr, 10);
        return value >= 256 * 1024 ? value : 0;
    }

    uint64_t window_budget() const {
        uint64_t limit = std::min<uint64_t>(storage_range_limit_, 64ull * 1024 * 1024);
        char setting[PROP_VALUE_MAX]{};
        if (__system_property_get("debug.theia.export_window_bytes", setting) > 0) {
            const uint64_t value = std::strtoull(setting, nullptr, 10);
            if (value >= 256 * 1024)
                limit = std::min(limit, value);
        }
        return limit;
    }

    std::vector<uint32_t> window_words(const std::vector<Arg>& args, size_t binding, size_t count,
                                       std::string& error) {
        if (binding >= args.size()) {
            error = "Missing window metadata";
            return {};
        }
        const auto& arg = args[binding];
        std::vector<uint32_t> result(count);
        if (arg.bytes && arg.size >= count * 4)
            std::memcpy(result.data(), arg.bytes, count * 4);
        else if (!arg.buffer || !read(arg.buffer, 0, result.data(), count * 4, error))
            return {};
        return result;
    }

    bool dispatch_windowed(const char* kernel, const std::vector<Arg>& args, size_t threads,
                           std::string& error) {
        using namespace theia::export_windows;
        const KernelSpec* spec = find_kernel(kernel);
        const Rule* layout = rule(kernel);
        if (!spec || !layout || args.size() != spec->bindings || args.size() > binding_count) {
            error = std::string("Unreviewed export window contract: ") + kernel;
            return false;
        }
        std::vector<BufferRef> owners;
        std::vector<Buffer*> buffers;
        for (const auto& arg : args) {
            Buffer* buffer = arg.buffer;
            if (!buffer && arg.bytes && arg.size) {
                owners.push_back(upload(arg.bytes, arg.size, error));
                if (!owners.back())
                    return false;
                buffer = owners.back().get();
            }
            if (!buffer) {
                error = "Empty export window binding";
                return false;
            }
            buffers.push_back(buffer);
        }
        std::vector<uint32_t> meta;
        std::vector<uint32_t> geometry;
        switch (layout->kind) {
        case Kind::Take:
            meta = window_words(args, 1, 2, error);
            break;
        case Kind::Pack16:
            meta = window_words(args, 1, 3, error);
            break;
        case Kind::Fir:
            meta = window_words(args, 4, 6, error);
            break;
        case Kind::Iir:
            meta = window_words(args, 5, 4, error);
            break;
        case Kind::Stride:
        case Kind::Zoom:
            meta = window_words(args, 1, 4, error);
            break;
        case Kind::Geometry:
            meta = window_words(args, 2, 6, error);
            geometry = window_words(args, 1, 16, error);
            break;
        case Kind::Copy:
            meta = window_words(args, 1, 6, error);
            break;
        default:
            break;
        }
        if (meta.empty() && layout->kind != Kind::Point && layout->kind != Kind::Opaque)
            return false;
        if (layout->kind == Kind::Geometry && geometry.empty())
            return false;
        const uint64_t limit = window_budget();
        const uint64_t alignment = std::max<uint64_t>(4, properties_.limits.minStorageBufferOffsetAlignment);
        auto spans_for = [&](uint64_t first, uint64_t last, std::array<Span, binding_count>& spans) {
            for (size_t i = 0; i < buffers.size(); ++i)
                spans[i] =
                    layout->stride[i] ? elements(first, last, layout->stride[i]) : Span{0, buffers[i]->used};
            switch (layout->kind) {
            case Kind::Take:
                spans[0] = elements(first, last, meta[1] * 4);
                break;
            case Kind::Pack16: {
                const uint64_t a = first / meta[1] * meta[2] + first % meta[1];
                const uint64_t z = (last - 1) / meta[1] * meta[2] + (last - 1) % meta[1] + 1;
                spans[2] = elements(a, z, 8);
                break;
            }
            case Kind::Fir: {
                const uint64_t h = meta[0], w = meta[1], radius = meta[3] == 0 ? meta[2] : 0;
                const uint64_t y0 = first / w, y1 = (last - 1) / w + 1;
                spans[0] = rows(y0 > radius ? y0 - radius : 0, std::min(h, y1 + radius), w);
                spans[2] = meta[4] ? elements(first, last, 12) : Span{0, 4};
                spans[5] = elements(first, last, 12);
                break;
            }
            case Kind::Iir: {
                const uint64_t y0 = first / 3, y1 = (last - 1) / 3 + 1;
                const Span image = meta[3] == 1 ? rows(y0, y1, meta[1]) : rows(0, meta[0], meta[1]);
                spans[0] = spans[6] = image;
                spans[3] = meta[2] ? image : Span{0, 4};
                break;
            }
            case Kind::Stride: {
                const uint64_t y0 = first / meta[2] * meta[3];
                const uint64_t y1 = (last - 1) / meta[2] * meta[3] + 1;
                spans[0] = rows(y0, y1, meta[0]);
                break;
            }
            case Kind::Zoom: {
                const double sh = meta[0], oh = meta[2];
                auto at = [&](uint64_t y) { return std::abs(((2.0 * y + 1.0) * sh - oh) / (2.0 * oh)); };
                const double a = at(first / meta[3]), b = at((last - 1) / meta[3]);
                const auto y0 = uint64_t(std::max(0.0, std::floor(std::min(a, b)) - 3));
                const auto y1 = uint64_t(std::min(sh, std::ceil(std::max(a, b)) + 4));
                spans[0] = rows(y0, y1, meta[1]);
                break;
            }
            case Kind::Geometry: {
                auto pair = [&](size_t i) {
                    float hi, lo;
                    std::memcpy(&hi, &geometry[2 * i], 4);
                    std::memcpy(&lo, &geometry[2 * i + 1], 4);
                    return double(hi) + double(lo);
                };
                const uint64_t ow = meta[3], y0 = first / ow, y1 = (last - 1) / ow;
                const uint64_t x0 = y0 == y1 ? first % ow : 0, x1 = y0 == y1 ? (last - 1) % ow : ow - 1;
                double low = std::numeric_limits<double>::infinity(), high = -low;
                for (auto y : {y0, y1})
                    for (auto x : {x0, x1}) {
                        double u = x + .5, v = y + .5;
                        if (meta[5] & 1)
                            u = double(ow) - u;
                        if (meta[5] & 2)
                            v = double(meta[2]) - v;
                        const double old = u;
                        if (meta[4] == 1) {
                            u = v;
                            v = double(ow) - old;
                        }
                        if (meta[4] == 2) {
                            u = double(ow) - u;
                            v = double(meta[2]) - v;
                        }
                        if (meta[4] == 3) {
                            u = double(meta[2]) - v;
                            v = old;
                        }
                        const double py =
                            pair(5) + (pair(0) * u - pair(2)) * pair(7) + (pair(1) * v - pair(3)) * pair(6);
                        low = std::min(low, py);
                        high = std::max(high, py);
                    }
                low = std::clamp(std::floor(low) - 4, 0.0, double(meta[0] - 1));
                high = std::clamp(std::ceil(high) + 5, low + 1, double(meta[0]));
                spans[0] = rows(uint64_t(low), uint64_t(high), meta[1]);
                break;
            }
            case Kind::Copy: {
                const Span full = rows(meta[3], uint64_t(meta[3]) + meta[4], meta[0]);
                const Span packed = rows(meta[3], uint64_t(meta[3]) + meta[4], meta[2]);
                spans[0] = meta[5] ? packed : full;
                spans[2] = meta[5] ? full : packed;
                break;
            }
            default:
                break;
            }
            for (size_t i = 0; i < buffers.size(); ++i) {
                spans[i] = aligned(spans[i], alignment);
                // Cross-grid proof/edge kernels not yet decomposed keep their
                // prior whole-binding contract when the real device permits it.
                // Never reject an otherwise legal existing feature solely
                // because of the smaller working-window policy.
                const uint64_t allowed = layout->kind == Kind::Opaque ? storage_range_limit_ : limit;
                if (spans[i].end <= spans[i].begin || spans[i].end > buffers[i]->used ||
                    spans[i].end - spans[i].begin > allowed)
                    return false;
            }
            return true;
        };

        std::lock_guard<std::mutex> lock(dispatch_mutex_);
        ComputePipeline* pipeline = get_pipeline(*spec, error);
        if (!pipeline || !pipeline->bounded)
            return false;
        VkDescriptorPoolSize pool_size{VK_DESCRIPTOR_TYPE_STORAGE_BUFFER, spec->bindings};
        VkDescriptorPoolCreateInfo pool_create{};
        pool_create.sType = VK_STRUCTURE_TYPE_DESCRIPTOR_POOL_CREATE_INFO;
        pool_create.maxSets = 1;
        pool_create.poolSizeCount = 1;
        pool_create.pPoolSizes = &pool_size;
        VkDescriptorPool pool = VK_NULL_HANDLE;
        VkResult result = vkCreateDescriptorPool(device_, &pool_create, nullptr, &pool);
        if (result != VK_SUCCESS) {
            error = vk_error("vkCreateDescriptorPool", result);
            return false;
        }
        struct PoolGuard {
            VkDevice device;
            VkDescriptorPool pool;
            ~PoolGuard() { vkDestroyDescriptorPool(device, pool, nullptr); }
        } guard{device_, pool};
        VkDescriptorSetAllocateInfo allocation{};
        allocation.sType = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_ALLOCATE_INFO;
        allocation.descriptorPool = pool;
        allocation.descriptorSetCount = 1;
        allocation.pSetLayouts = &pipeline->descriptors;
        VkDescriptorSet set = VK_NULL_HANDLE;
        result = vkAllocateDescriptorSets(device_, &allocation, &set);
        if (result != VK_SUCCESS) {
            error = vk_error("vkAllocateDescriptorSets", result);
            return false;
        }
        std::vector<VkDescriptorBufferInfo> infos(args.size());
        std::vector<VkWriteDescriptorSet> writes(args.size());
        for (size_t i = 0; i < writes.size(); ++i) {
            writes[i].sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET;
            writes[i].dstSet = set;
            writes[i].dstBinding = uint32_t(i);
            writes[i].descriptorCount = 1;
            writes[i].descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_BUFFER;
            writes[i].pBufferInfo = &infos[i];
        }
        ++theia::export_execution::dispatch_stats.kernels;
        for (uint64_t first = 0; first < threads;) {
            if (theia::export_execution::cancellation &&
                theia::export_execution::cancellation->load(std::memory_order_relaxed)) {
                error = "render cancelled";
                return false;
            }
            uint64_t count = std::min<uint64_t>(
                threads - first,
                std::min<uint64_t>(properties_.limits.maxComputeWorkGroupCount[0] * uint64_t(spec->workgroup),
                                   layout->kind == Kind::Iir ? 2048 : 1048576));
            std::array<Span, binding_count> spans{};
            while (!spans_for(first, first + count, spans)) {
                if (count <= 1) {
                    error = std::string(kernel) + ": no legal exact storage window (maxStorageBufferRange)";
                    return false;
                }
                count = (count + 1) / 2;
            }
            Push push;
            push.base = uint32_t(first);
            push.end = uint32_t(first + count);
            for (size_t i = 0; i < args.size(); ++i) {
                infos[i] = {buffers[i]->handle, spans[i].begin, spans[i].end - spans[i].begin};
                theia::export_execution::dispatch_stats.largest_binding_bytes = std::max(
                    theia::export_execution::dispatch_stats.largest_binding_bytes, size_t(infos[i].range));
                push.origin[i] = uint32_t(spans[i].begin / 4);
            }
            vkUpdateDescriptorSets(device_, uint32_t(writes.size()), writes.data(), 0, nullptr);
            if (!submit_sync(
                    [&](VkCommandBuffer command) {
                        device_barrier(command, VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
                                       VK_ACCESS_SHADER_READ_BIT | VK_ACCESS_SHADER_WRITE_BIT);
                        vkCmdBindPipeline(command, VK_PIPELINE_BIND_POINT_COMPUTE, pipeline->pipeline);
                        vkCmdBindDescriptorSets(command, VK_PIPELINE_BIND_POINT_COMPUTE, pipeline->layout, 0,
                                                1, &set, 0, nullptr);
                        vkCmdPushConstants(command, pipeline->layout, VK_SHADER_STAGE_COMPUTE_BIT, 0,
                                           sizeof push, &push);
                        vkCmdDispatch(command, uint32_t((count + spec->workgroup - 1) / spec->workgroup), 1,
                                      1);
                    },
                    "Vulkan windowed dispatch", error))
                return false;
            ++theia::export_execution::dispatch_stats.submissions;
            theia::export_execution::dispatch_stats.largest_invocations =
                std::max(theia::export_execution::dispatch_stats.largest_invocations, size_t(count));
            first += count;
        }
        return true;
    }
