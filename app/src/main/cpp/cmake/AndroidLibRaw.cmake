# Keep the Android decoder pin independent of the desktop engine's dependency.
set(theia_libraw_lock "${CMAKE_CURRENT_LIST_DIR}/../../../../../tools/libraw.lock.json")
file(READ "${theia_libraw_lock}" theia_libraw_json)
string(JSON THEIA_LIBRAW_VERSION GET "${theia_libraw_json}" version)
string(JSON THEIA_LIBRAW_COMMIT GET "${theia_libraw_json}" commit)
string(JSON theia_libraw_directory GET "${theia_libraw_json}" directory)
set(THEIA_LIBRAW_SOURCE "${CMAKE_CURRENT_LIST_DIR}/../../../../../../deps/${theia_libraw_directory}"
    CACHE PATH "Verified Android LibRaw source (tools/setup_libraw.py)")
if(NOT EXISTS "${THEIA_LIBRAW_SOURCE}/libraw/libraw.h")
    message(FATAL_ERROR "Pinned Android LibRaw is missing. Run python tools/setup_libraw.py; expected ${THEIA_LIBRAW_SOURCE}")
endif()
string(JSON theia_libraw_count LENGTH "${theia_libraw_json}" verified_files)
math(EXPR theia_libraw_last "${theia_libraw_count} - 1")
foreach(index RANGE ${theia_libraw_last})
    string(JSON relative MEMBER "${theia_libraw_json}" verified_files ${index})
    string(JSON expected GET "${theia_libraw_json}" verified_files "${relative}")
    file(SHA256 "${THEIA_LIBRAW_SOURCE}/${relative}" actual)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "Pinned LibRaw source differs: ${relative}; run tools/setup_libraw.py to verify the source tree")
    endif()
endforeach()
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${theia_libraw_lock}")
file(GLOB_RECURSE spk_libraw_sources CONFIGURE_DEPENDS "${THEIA_LIBRAW_SOURCE}/src/*.cpp")
list(FILTER spk_libraw_sources EXCLUDE REGEX "/[^/]*_ph\\.cpp$")
add_library(spk_libraw STATIC ${spk_libraw_sources})
target_include_directories(spk_libraw PUBLIC "${THEIA_LIBRAW_SOURCE}")
target_compile_definitions(spk_libraw PUBLIC LIBRAW_NODLL)
target_compile_features(spk_libraw PRIVATE cxx_std_17)
target_compile_options(spk_libraw PUBLIC -fopenmp)
# The NDK supplies libomp.a for both shipped ABIs. Embed it once; no extra .so
# or loader-order dependency, and the final link keeps Android page alignment.
target_link_options(spk_libraw INTERFACE -fopenmp -static-openmp)
set_target_properties(spk_libraw PROPERTIES POSITION_INDEPENDENT_CODE ON)
if(CMAKE_CXX_COMPILER_ID MATCHES "Clang|GNU")
    target_compile_options(spk_libraw PRIVATE -w)
endif()
file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/generated")
configure_file("${CMAKE_CURRENT_LIST_DIR}/templates/LibRawBuild.hpp.in"
    "${CMAKE_CURRENT_BINARY_DIR}/generated/theia_libraw_build.hpp" @ONLY)
message(STATUS "Android LibRaw: ${THEIA_LIBRAW_VERSION} (${THEIA_LIBRAW_COMMIT}); bounded static OpenMP")
